# Ghassan AI — build artifacts (never commit; local + Kaggle only)
# NOTE: both build layouts are ignored: kaggle/setup.sh uses build/,
# local Windows verification builds use build_test/. Binaries/logs inside
# them (Testing/, bin/, *.ninja) must never pollute git status.
build/
build_test/
out/
.vs/
*.user
*.suo
*.sdf
*.opensdf

# Compiled objects / libs / exes
*.obj
*.o
*.lib
*.a
*.so
*.dll
*.exe
*.pdb
*.ilk
*.exp

# Training artifacts (large, local/Kaggle only)
artifacts/
kaggle_upload/
*.parquet
*.ckpt
*.gai
*.gguf
*.gbin
*.gtok
*.jsonl
!evaluation/datasets/**/*.jsonl

# Kaggle / local temp
*.log
*.tlog
*.recipe
*.lastbuildstate
tmp/
temp/

# OS / editor
.DS_Store
Thumbs.db
Desktop.ini
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
.idea/
*.swp
*~

# Python / misc
__pycache__/
*.pyc
.venv/
